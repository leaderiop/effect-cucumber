{
  "name": "@effect-cucumber/gherkin",
  "version": "0.2.0",
  "description": "Gherkin feature-file parsing for effect-cucumber. Effect-native; effect is a peer dependency only (ADR-EC-021), never bundled. Uses core effect's FileSystem service interface; depends on no concrete platform implementation.",
  "keywords": [
    "gherkin",
    "cucumber",
    "bdd",
    "parser",
    "feature-file"
  ],
  "license": "MIT",
  "homepage": "https://github.com/leaderiop/effect-cucumber#readme",
  "bugs": {
    "url": "https://github.com/leaderiop/effect-cucumber/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leaderiop/effect-cucumber.git",
    "directory": "packages/gherkin"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@cucumber/cucumber-expressions": "^20.1.0"
  },
  "peerDependencies": {
    "effect": "catalog:peer"
  },
  "devDependencies": {
    "effect": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  }
}
