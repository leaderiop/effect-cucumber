{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "noEmit": true,
    // Widened to the repo root, overriding tsconfig.base.json's `${configDir}/src`.
    //
    // The DSL fixtures import `@effect-cucumber/vitest` the way a real consumer writes it. That
    // self-reference resolves through this package's own `exports["."]` to packages/vitest/src/,
    // which is outside this directory — so the inherited rootDir rejects the whole program with
    // TS6059 before a single Effect diagnostic is reached. (`@effect-cucumber/gherkin` does not
    // trip it, because it resolves through node_modules and rootDir does not police those.)
    //
    // `noEmit: true` above makes this inert: rootDir only controls output layout, and nothing here
    // emits. It is set to the repo root rather than to packages/vitest so that a later fixture
    // reaching for another workspace package does not have to reopen this shared file.
    "rootDir": "${configDir}/../../../.."
  },
  "include": [],
  // This file is BOTH the shared parent that tsconfig.ok.json / tsconfig.floating.json extend
  // AND the NEG_CONFIG that assertion 4 of scripts/verify-tsgo-gate.sh compiles. Those two roles
  // pull in opposite directions, and only one of them is visible from the file itself.
  //
  // With an unscoped `include: ["src"]`, every fixture added to src/ from now on would silently
  // fold into assertion 4's compilation: a new positive fixture would mix its diagnostics into
  // NEG_OUTPUT, and a new negative one could satisfy the `effect(missingLayerContext)` grep on
  // behalf of a file assertion 4 was never about. The assertion would stop being specific about
  // the Layer-context guarantee without ever failing — a gate that reports ENFORCED while
  // covering nothing.
  //
  // So: exactly one file, matching the two sibling configs' shape. Do NOT "simplify" this back to
  // an `include` glob. A new fixture gets its own config instead.
  "files": ["src/missing-layer-context.ts"]
}
