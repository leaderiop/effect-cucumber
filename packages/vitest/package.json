{
  "name": "@effect-cucumber/vitest",
  "version": "0.0.0",
  "description": "Effect-native Gherkin/Cucumber runner for vitest.",
  "keywords": [
    "effect",
    "effect-ts",
    "vitest",
    "cucumber",
    "gherkin",
    "bdd",
    "testing"
  ],
  "license": "MIT",
  "homepage": "https://github.com/leaderiop/effect-cucumber#readme",
  "bugs": {
    "url": "https://github.com/leaderiop/effect-cucumber/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leaderiop/effect-cucumber.git",
    "directory": "packages/vitest"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect-cucumber/gherkin": "workspace:^"
  },
  "peerDependencies": {
    "effect": "catalog:peer",
    "@effect/vitest": "catalog:peer",
    "vitest": "catalog:peer"
  },
  "devDependencies": {
    "effect": "catalog:",
    "@effect/vitest": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  }
}
