{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "oxc", "eslint", "unicorn", "vitest"],
  "jsPlugins": [
    { "name": "effect", "specifier": "./tools/oxlint/effect/index.ts" },
    { "name": "effect-cucumber", "specifier": "./scripts/templates/oxlint-ref-state/index.ts" }
  ],
  "categories": { "correctness": "error", "suspicious": "error", "perf": "error" },
  "ignorePatterns": [
    "**/dist",
    "**/node_modules",
    "**/*.md",
    ".planning",
    "packages/vitest/test/tsgo-gate"
  ],
  "rules": {
    "eqeqeq": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": ["error", { "preferInline": true }],
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "unicorn/prefer-node-protocol": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-identical-title": "error",
    "effect/no-import-from-barrel-package": ["error", {
      "checkPatterns": [
        "^effect$",
        "^effect/(.+/)?[a-z][a-z0-9]*$",
        // `@effect/vitest` is EXEMPTED by the negative lookahead, and it is the one exemption.
        // The rule assumes an Effect package publishes a module per file, so its fix is "import
        // from the specific module instead". @effect/vitest does not: its package.json maps "."
        // to dist/index.js and the only other file is dist/utils.js, so the suggested
        // `@effect/vitest/describe` / `/expect` / `/it` do not resolve to anything. The rule was
        // therefore unfollowable for the only import that yields `it.effect`, which AGENTS.md §5
        // mandates for every test in this repo.
        //
        // Scoped to this ONE package name on purpose. Do NOT "simplify" this back to
        // `^@effect/[^/]+$` (re-breaks @effect/vitest), and do NOT widen it to a rule-off override
        // for test files — that would also stop catching `import { Effect } from "effect"`, which
        // is a real barrel import the rule exists to reject and which tests are as prone to as
        // src. Every other @effect/* package is still checked; verified against @effect/platform
        // and @effect/tsgo.
        "^@effect/(?!vitest$)[^/]+$",
        "^@effect/[^/]+/(.+/)?[a-z][a-z0-9]*$"
      ],
      "checkRelativeIndexImports": true
    }],
    "effect/no-js-extension-imports": "error",
    "effect/no-opaque-instance-fields": "error",
    "effect/no-bigint-literals": "error"
  },
  "overrides": [
    {
      // Vendored from Effect-TS/effect (see tools/oxlint/effect/ATTRIBUTION.md).
      // Upstream defines its test helpers inside `describe` blocks for locality.
      // Holding vendored code to our stylistic rules would force local edits and
      // break the documented `curl` resync path. Correctness/suspicious/perf
      // categories stay ON here — only this style rule is relaxed.
      "files": ["tools/oxlint/effect/**"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      // Dogfoods scripts/templates/oxlint-ref-state/'s ref-state-only rule against this repo's own
      // acceptance suite — see ADR-EC-042's Correction. Scoped here, not global: the rest of the
      // codebase (Runner.ts, VitestTestApi.ts, ...) legitimately uses let/mutation outside the
      // INV-EC-006 boundary this rule polices, which is specifically cross-step Scenario state in
      // step modules. scripts/verify-acceptance-ref-state.sh already enforces the identical rule
      // over this same directory at CI time; this is the same boundary, now also caught inline.
      "files": ["packages/vitest/test/acceptance/**"],
      "rules": {
        "effect-cucumber/ref-state-only": "error"
      }
    }
  ]
}
