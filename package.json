{
  "name": "effect-cucumber",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "build": "tsc -b",
    "test": "vitest run",
    "test:shuffle": "vitest run --sequence.shuffle",
    "coverage": "vitest run --coverage",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint -f unix && dprint check",
    "lint-fix": "oxlint --fix && dprint fmt",
    "circular": "madge --circular --extensions ts packages/*/src",
    "typecheck:test": "tsc --noEmit -p packages/gherkin/tsconfig.test.json && tsc --noEmit -p packages/vitest/tsconfig.test.json",
    "snapshot": "pkg-pr-new publish --pnpm ./packages/*",
    "verify:pack": "bash scripts/verify-pack.sh",
    "verify:spec": "bash spec/scripts/verify-traceability.sh --strict",
    "verify:tsgo-gate": "bash scripts/verify-tsgo-gate.sh",
    "verify:oxlint-plugin": "bash scripts/verify-oxlint-plugin.sh",
    "verify:no-runner-dep": "bash scripts/verify-no-runner-dep.sh",
    "verify:testapi-seam": "bash scripts/verify-testapi-seam.sh",
    "verify:tags-filter": "bash scripts/verify-tags-filter.sh",
    "verify:shared-layer-once": "bash scripts/verify-shared-layer-once.sh",
    "verify:acceptance-ref-state": "bash scripts/verify-acceptance-ref-state.sh",
    "verify:acceptance-no-any": "bash scripts/verify-acceptance-no-any.sh",
    "verify:watch-rerun": "bash scripts/verify-watch-rerun.sh",
    "verify:failure-panel": "bash scripts/verify-failure-panel.sh",
    "verify:attachments-panel": "bash scripts/verify-attachments-panel.sh",
    "verify:rerun-failed-only": "bash scripts/verify-rerun-failed-only.sh",
    "verify:pitfalls": "bash scripts/verify-pitfalls-checklist.sh",
    "verify:api-surface": "bash scripts/verify-api-surface.sh",
    "verify:doc-examples": "bash scripts/verify-doc-examples.sh",
    "verify:no-planning-refs": "bash scripts/verify-no-planning-refs.sh",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@effect/tsgo": "0.38.0",
    "@oxlint/plugins": "1.80.0",
    "@vitest/coverage-v8": "catalog:",
    "dprint": "0.56.1",
    "madge": "8.0.0",
    "oxlint": "1.80.0",
    "pkg-pr-new": "0.0.88",
    "publint": "0.3.24",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
